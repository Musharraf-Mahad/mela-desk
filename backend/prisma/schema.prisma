generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id             String    @id @default(cuid())
  email          String    @unique @db.VarChar(255)
  name           String    @db.VarChar(120)
  passwordHash   String    @map("password_hash") @db.VarChar(255)
  role           UserRole  @default(customer)
  isActive       Boolean   @default(true) @map("is_active")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  tickets        Ticket[]  @relation("TicketCustomer")
  assignedTickets Ticket[] @relation("TicketAssignee")
  comments       Comment[]
  auditLogs      AuditLog[]

  @@map("users")
  @@index([email])
}

model Ticket {
  id          String         @id @default(cuid())
  customerId  String         @map("customer_id")
  assigneeId  String?        @map("assignee_id")
  subject     String         @db.VarChar(255)
  description String         @db.Text
  category    TicketCategory
  priority    TicketPriority
  status      TicketStatus   @default(open)
  createdAt   DateTime       @default(now()) @map("created_at")
  updatedAt   DateTime       @updatedAt @map("updated_at")
  customer    User           @relation("TicketCustomer", fields: [customerId], references: [id], onDelete: Cascade)
  assignee    User?          @relation("TicketAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  comments    Comment[]
  auditLogs   AuditLog[]

  @@map("tickets")
  @@index([customerId])
  @@index([assigneeId])
  @@index([status])
  @@index([category])
  @@index([priority])
}

model Comment {
  id         String   @id @default(cuid())
  ticketId   String   @map("ticket_id")
  authorId   String   @map("author_id")
  body       String   @db.Text
  isInternal Boolean  @default(false) @map("is_internal")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")
  ticket     Ticket   @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  author     User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@map("comments")
  @@index([ticketId])
  @@index([authorId])
  @@index([isInternal])
}

model AuditLog {
  id        String    @id @default(cuid())
  ticketId   String?   @map("ticket_id")
  userId     String?   @map("user_id")
  action     String    @db.VarChar(100)
  details    String?   @db.Text
  createdAt  DateTime  @default(now()) @map("created_at")
  ticket     Ticket?   @relation(fields: [ticketId], references: [id], onDelete: SetNull)
  user       User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@index([ticketId])
  @@index([userId])
  @@index([action])
}

enum UserRole {
  customer
  agent
  admin
}

enum TicketCategory {
  billing
  account
  technical
  orders
  general
}

enum TicketPriority {
  low
  normal
  high
  urgent
}

enum TicketStatus {
  open
  in_progress
  pending
  resolved
  closed
}
